{
  "name": "@aiwerk/mcp-server-wheel-size",
  "version": "0.3.0",
  "description": "Wheel-Size.com API MCP server — vehicle wheel, tyre and fitment data lookup",
  "type": "module",
  "main": "dist/src/server.js",
  "bin": {
    "mcp-server-wheel-size": "dist/src/server.js"
  },
  "scripts": {
    "gen-version": "node scripts/gen-version.mjs",
    "prebuild": "npm run gen-version",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "predev": "npm run gen-version",
    "dev": "tsc --watch",
    "pretest": "npm run gen-version",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test && node scripts/gen-tool-list.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "wheel-size",
    "wheels",
    "tyres",
    "fitment",
    "automotive"
  ],
  "author": "AIWerk <kontakt@aiwerk.ch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIWerk/mcp-server-wheel-size.git"
  },
  "homepage": "https://aiwerkmcp.com",
  "bugs": {
    "url": "https://github.com/AIWerk/mcp-server-wheel-size/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.1"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
